# Shared Flutter/Python/Node/npm/npx/Deno build and browser-test environment.
# Default: existing static portable E2E. Opt in with CURL_PYTHON_RUNTIME=true
# to exercise the real Python parser and Flutter UI inside the same container.
# This is a build/test image, not an Android/iOS interpreter package or a
# production HTTP service. See docs/curl-runtime.md.

ARG DENO_VERSION=2.9.6
FROM denoland/deno:bin-${DENO_VERSION} AS deno
FROM ubuntu:24.04

ARG FLUTTER_VERSION=3.47.0
ARG NODE_MAJOR=22

ENV DEBIAN_FRONTEND=noninteractive \
    DENO_NO_UPDATE_CHECK=1 \
    DENO_NO_PROMPT=1 \
    PATH=/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:$PATH
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git unzip xz-utils python3 \
    && curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
COPY --from=deno /deno /usr/local/bin/deno
RUN python3 --version && node --version && npm --version && npx --version && deno --version

# Download the pinned SDK from Flutter's official distribution.
RUN curl -fsSL \
        "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
        -o /tmp/flutter.tar.xz \
    && tar -xJf /tmp/flutter.tar.xz -C /opt \
    && rm /tmp/flutter.tar.xz \
    && git config --global --add safe.directory /opt/flutter \
    && flutter config --no-analytics --no-cli-animations \
    && flutter precache --web

WORKDIR /repo
COPY pubspec.yaml pubspec.lock ./
RUN cp pubspec.lock /tmp/pubspec.lock \
    && flutter pub get \
    && cmp /tmp/pubspec.lock pubspec.lock

# Keep the repository's existing npm range policy. The installed package tree
# and browser revisions are retained in this tested image; toolchain.log records
# the resolved versions. No npm/npx download occurs at test startup.
COPY e2e/package.json e2e/package.json
RUN npm install --prefix e2e \
    && npx --prefix e2e playwright install --with-deps chromium firefox webkit

COPY . .
# Keep this late so switching runtime mode reuses SDK/dependency/browser layers.
ARG CURL_PYTHON_RUNTIME=false
ENV CURL_RUNTIME_E2E=${CURL_PYTHON_RUNTIME}
RUN case "$CURL_PYTHON_RUNTIME" in true|false) ;; *) exit 2 ;; esac \
    && flutter pub get \
    && cmp /tmp/pubspec.lock pubspec.lock \
    && flutter build web --release -t lib/main.dart --dart-define=E2E=true --base-href "/" --dart-define=CURL_PYTHON_RUNTIME=${CURL_PYTHON_RUNTIME}
RUN deno run --no-config --no-lock --no-remote tool/docker/toolchain_smoke.ts

EXPOSE 8080
ENTRYPOINT ["tool/docker/e2e-entrypoint.sh"]
CMD ["test", "--project", "chromium", "--project", "firefox", "--project", "webkit", "--project", "mobile-chromium", "--project", "mobile-webkit", "--grep", "@portable", "--max-failures", "1", "tests/hub_navigation.spec.ts", "tests/screen_navigation.spec.ts", "tests/photo_studio.spec.ts", "tests/photo_studio_ingress.spec.ts", "tests/photo_studio_format_matrix.spec.ts"]
